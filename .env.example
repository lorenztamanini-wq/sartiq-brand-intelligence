# Copy to .env and fill in. Everything here is OPTIONAL — with no keys the
# system runs in deterministic offline mode and still produces sourced briefs.

# Live digging (the Claude tool-use research loop, vision, synthesis).
ANTHROPIC_API_KEY=

# Q7 people enrichment (named contact). Apollo preferred; never LinkedIn scraping.
APOLLO_API_KEY=

# Optional semantic-search depth for the research loop.
EXA_API_KEY=
TAVILY_API_KEY=

# --- Tunables (sensible defaults; override only if needed) ---
# BRAND_BRIEF_MODEL=claude-opus-4-8
# BRAND_BRIEF_VISION_MODEL=claude-opus-4-8   # claude-haiku-4-5 is cheaper at catalog scale
# BRAND_BRIEF_MAX_TOOL_CALLS=25              # agent guardrail: hard cap on tool calls
# BRAND_BRIEF_WALL_CLOCK_S=300               # agent guardrail: wall-clock budget
# BRAND_BRIEF_PDP_SAMPLE=30                  # PDPs sampled per brand (20-40)
# BRAND_BRIEF_HTTP_TIMEOUT=20
